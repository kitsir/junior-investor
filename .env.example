# Railway PostgreSQL (Railway inject this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret for JWT signing (ตั้งค่าใน Railway environment variables)
JWT_SECRET=change-this-to-a-random-secret

# Vercel frontend URL (เพื่อให้ CORS อนุญาต)
FRONTEND_URL=https://your-app.vercel.app

# Set to production on Railway
NODE_ENV=production
